From 91e121b49df66b15dc1bbf7f158b415172ece87f Mon Sep 17 00:00:00 2001
From: Erwan SZYMANSKI <erwan.szymanski@st.com>
Date: Mon, 16 Oct 2023 11:45:54 +0200
Subject: [PATCH] ARM: dts: stm32: Adding STPM4RasPI on i2c5 nodes

Upstream-Status: Inappropriate [TPM expansion board specific configuration]
Change-Id: I13a941dc8db341a42ba7bff9de41174c8f7db055
---
 arch/arm/boot/dts/st/stm32mp135f-dk.dts   | 6 ++++++
 arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi | 8 +++++++-
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/st/stm32mp135f-dk.dts b/arch/arm/boot/dts/st/stm32mp135f-dk.dts
index b105f5d4ef17..ad8960a7f80a 100644
--- a/arch/arm/boot/dts/st/stm32mp135f-dk.dts
+++ b/arch/arm/boot/dts/st/stm32mp135f-dk.dts
@@ -472,6 +472,12 @@
 		touchscreen-size-y = <272>;
 		status = "okay" ;
 	};
+
+	st33htpi: st33htpi@0{
+		compatible = "infineon,slb9673", "tcg,tpm-tis-i2c";
+		reg = <0x2e>;
+		status="okay";
+	};
 };
 
 &iwdg2 {
diff --git a/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi b/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
index 979afc5f1c09..ad9f7a156cfb 100644
--- a/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
@@ -604,7 +604,13 @@
 	/* spare dmas for other usage */
 	/delete-property/dmas;
 	/delete-property/dma-names;
-	status = "disabled";
+	status = "okay";
+
+	st33htpi: st33htpi@0{
+		compatible = "infineon,slb9673", "tcg,tpm-tis-i2c";
+		reg = <0x2e>;
+		status="okay";
+	};
 };
 
 &i2s2 {
-- 
2.34.1

